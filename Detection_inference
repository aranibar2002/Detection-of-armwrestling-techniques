# ======================================================================
# 15. LOAD MODEL
# ======================================================================

gc.collect()


if torch.cuda.is_available():

    torch.cuda.empty_cache()


print(
    "\nLoading DINO + Swin-L..."
)


model = init_detector(

    cfg,

    str(
        CHECKPOINT_PATH
    ),

    device=DEVICE,

    palette="random"
)


# Жёстко задаём именно наши классы.

model.dataset_meta = {

    "classes":
        CLASSES,

    "palette":
        "random"
}


model.eval()


print(
    "✓ Model loaded"
)


print(
    "\nClasses:"
)


for index, name in enumerate(
    CLASSES
):

    print(
        f"  {index} -> {name}"
    )


# ======================================================================
# 16. СТРОГИЙ COCO INSTANCES ДЛЯ CVAT
#
# НИКАКИХ:
#
# score
# confidence
# inference_summary
# model_name
# prediction
# дополнительных attributes
#
# Только стандартные COCO поля.
# ======================================================================

coco = {

    "images": [],

    "annotations": [],

    "categories": [

        {
            "id": 1,
            "name": "Toproll",
            "supercategory": ""
        },

        {
            "id": 2,
            "name": "Hook",
            "supercategory": ""
        },

        {
            "id": 3,
            "name": "Press",
            "supercategory": ""
        },

        {
            "id": 4,
            "name": "Kingsmove",
            "supercategory": ""
        },
    ]
}


# ======================================================================
# 17. СТАТИСТИКА — ТОЛЬКО ВЫВОДИМ В COLAB
#
# В JSON ЭТО НЕ ЗАПИСЫВАЕТСЯ.
# ======================================================================

annotation_id = 1

total_detections = 0

count_0 = 0
count_1 = 0
count_2 = 0
count_more_2 = 0


# ======================================================================
# 18. INFERENCE
# ======================================================================

print("\n" + "=" * 76)

print(
    "START INFERENCE"
)

print("=" * 76)


with torch.inference_mode():

    for image_id, image_path in enumerate(

        tqdm(
            image_paths,
            desc="DINO inference"
        ),

        start=1
    ):

        # ------------------------------------------------------
        # READ IMAGE
        # ------------------------------------------------------

        image = cv2.imread(
            str(
                image_path
            )
        )


        if image is None:

            raise RuntimeError(
                f"Не удалось прочитать:\n"
                f"{image_path}"
            )


        height, width = (
            image.shape[:2]
        )


        # ------------------------------------------------------
        # FILE NAME FOR CVAT
        # ------------------------------------------------------

        if USE_ONLY_FILENAME_FOR_CVAT:

            file_name = (
                image_path.name
            )

        else:

            file_name = (
                image_path
                .relative_to(
                    LOCAL_IMAGES_DIR
                )
                .as_posix()
            )


        # ------------------------------------------------------
        # COCO IMAGE RECORD
        # ------------------------------------------------------

        coco[
            "images"
        ].append(
            {
                "id":
                    int(
                        image_id
                    ),

                "width":
                    int(
                        width
                    ),

                "height":
                    int(
                        height
                    ),

                "file_name":
                    str(
                        file_name
                    )
            }
        )


        # ------------------------------------------------------
        # MODEL INFERENCE
        # ------------------------------------------------------

        result = inference_detector(

            model,

            str(
                image_path
            )
        )


        pred = (
            result
            .pred_instances
            .cpu()
        )


        boxes = (
            pred.bboxes.numpy()
        )


        scores = (
            pred.scores.numpy()
        )


        labels = (
            pred.labels.numpy()
            .astype(
                np.int64
            )
        )


        # ------------------------------------------------------
        # SCORE FILTER
        # ------------------------------------------------------

        keep = (
            scores
            >=
            SCORE_THRESHOLD
        )


        boxes = (
            boxes[
                keep
            ]
        )


        scores = (
            scores[
                keep
            ]
        )


        labels = (
            labels[
                keep
            ]
        )


        # ------------------------------------------------------
        # SORT BY CONFIDENCE
        #
        # Confidence используется только ВНУТРИ скрипта.
        # В CVAT JSON он НЕ попадёт.
        # ------------------------------------------------------

        if len(scores) > 0:

            order = np.argsort(
                -scores
            )

            boxes = (
                boxes[
                    order
                ]
            )

            scores = (
                scores[
                    order
                ]
            )

            labels = (
                labels[
                    order
                ]
            )


        # ------------------------------------------------------
        # OPTIONAL TOP-2
        # ------------------------------------------------------

        if KEEP_ONLY_TOP_2:

            boxes = (
                boxes[
                    :TOP_K
                ]
            )

            scores = (
                scores[
                    :TOP_K
                ]
            )

            labels = (
                labels[
                    :TOP_K
                ]
            )


        n_predictions = len(
            boxes
        )


        if n_predictions == 0:

            count_0 += 1

        elif n_predictions == 1:

            count_1 += 1

        elif n_predictions == 2:

            count_2 += 1

        else:

            count_more_2 += 1


        # ------------------------------------------------------
        # CREATE COCO ANNOTATIONS
        #
        # MMDetection:
        # [x1, y1, x2, y2]
        #
        # COCO:
        # [x, y, width, height]
        # ------------------------------------------------------

        for box, label in zip(

            boxes,

            labels
        ):

            label = int(
                label
            )


            if (
                label
                not in
                LABEL_TO_CATEGORY_ID
            ):

                raise ValueError(
                    f"Неизвестный label: {label}"
                )


            x1, y1, x2, y2 = [

                float(x)

                for x in box
            ]


            # --------------------------------------------------
            # CLIP TO IMAGE
            # --------------------------------------------------

            x1 = max(
                0.0,
                min(
                    x1,
                    float(width)
                )
            )


            y1 = max(
                0.0,
                min(
                    y1,
                    float(height)
                )
            )


            x2 = max(
                0.0,
                min(
                    x2,
                    float(width)
                )
            )


            y2 = max(
                0.0,
                min(
                    y2,
                    float(height)
                )
            )


            bbox_width = (
                x2 - x1
            )


            bbox_height = (
                y2 - y1
            )


            if (
                bbox_width <= 0
                or
                bbox_height <= 0
            ):

                continue


            category_id = (
                LABEL_TO_CATEGORY_ID[
                    label
                ]
            )


            # --------------------------------------------------
            # STRICT COCO ANNOTATION
            #
            # ВАЖНО:
            # score здесь НЕТ.
            # --------------------------------------------------

            annotation = {

                "id":
                    int(
                        annotation_id
                    ),

                "image_id":
                    int(
                        image_id
                    ),

                "category_id":
                    int(
                        category_id
                    ),

                "bbox": [
                    round(
                        float(
                            x1
                        ),
                        4
                    ),

                    round(
                        float(
                            y1
                        ),
                        4
                    ),

                    round(
                        float(
                            bbox_width
                        ),
                        4
                    ),

                    round(
                        float(
                            bbox_height
                        ),
                        4
                    ),
                ],

                "area":
                    round(
                        float(
                            bbox_width
                            *
                            bbox_height
                        ),
                        4
                    ),

                "segmentation":
                    [],

                "iscrowd":
                    0
            }


            coco[
                "annotations"
            ].append(
                annotation
            )


            annotation_id += 1

            total_detections += 1


# ======================================================================
# 19. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА COCO ПЕРЕД СОХРАНЕНИЕМ
# ======================================================================

print(
    "\nChecking generated COCO..."
)


image_ids = {

    int(
        x["id"]
    )

    for x in coco[
        "images"
    ]
}


category_ids = {

    int(
        x["id"]
    )

    for x in coco[
        "categories"
    ]
}


annotation_ids = []


for ann in coco[
    "annotations"
]:

    # Только разрешённые ключи.

    allowed_keys = {
        "id",
        "image_id",
        "category_id",
        "bbox",
        "area",
        "segmentation",
        "iscrowd",
    }


    unknown_keys = (
        set(
            ann.keys()
        )
        -
        allowed_keys
    )


    if unknown_keys:

        raise RuntimeError(
            f"В annotation обнаружены "
            f"лишние ключи: "
            f"{unknown_keys}"
        )


    assert (
        ann[
            "image_id"
        ]
        in
        image_ids
    )


    assert (
        ann[
            "category_id"
        ]
        in
        category_ids
    )


    assert (
        len(
            ann[
                "bbox"
            ]
        )
        ==
        4
    )


    assert (
        ann[
            "bbox"
        ][2]
        >
        0
    )


    assert (
        ann[
            "bbox"
        ][3]
        >
        0
    )


    annotation_ids.append(
        ann[
            "id"
        ]
    )


if (
    len(annotation_ids)
    !=
    len(
        set(
            annotation_ids
        )
    )
):

    raise RuntimeError(
        "Есть повторяющиеся annotation id."
    )


print(
    "✓ COCO structure valid"
)


# ======================================================================
# 20. СОХРАНЯЕМ СНАЧАЛА В /content
#
# Чтобы не делать сотни записей на Google Drive.
# ======================================================================

LOCAL_JSON = (
    LOCAL_ROOT
    /
    "instances_cvat.json"
)


with open(
    LOCAL_JSON,
    "w",
    encoding="utf-8"
) as f:

    json.dump(
        coco,
        f,
        ensure_ascii=False,
        indent=2,
        allow_nan=False
    )


# ======================================================================
# 21. ФИНАЛЬНАЯ ПРОВЕРКА ЧТЕНИЯ JSON
# ======================================================================

with open(
    LOCAL_JSON,
    "r",
    encoding="utf-8"
) as f:

    test_json = (
        json.load(
            f
        )
    )


assert (
    set(
        test_json.keys()
    )
    ==
    {
        "images",
        "annotations",
        "categories"
    }
)


print(
    "✓ JSON serialization valid"
)


# ======================================================================
# 22. ОДНА ЗАПИСЬ НА GOOGLE DRIVE
# ======================================================================

shutil.copy2(
    LOCAL_JSON,
    FINAL_JSON
)


if not FINAL_JSON.is_file():

    raise RuntimeError(
        "Не удалось сохранить итоговый JSON."
    )


