# ======================================================================
# DINO + SWIN-L INFERENCE -> CVAT-COMPATIBLE COCO 1.0 JSON
#
# ПАКЕТЫ УЖЕ УСТАНОВЛЕНЫ.
#
# 3 ПУТИ:
#
# 1. MODEL_DIR
#    Папка с:
#       *.pth   - лучшие веса
#       *.py    - config
#       *.json  - metrics (может лежать, для inference не нужен)
#
# 2. INPUT_IMAGES_DIR
#    Папка с изображениями
#
# 3. OUTPUT_DIR
#    Папка, куда будет сохранён:
#       instances_cvat.json
#
# Итоговый JSON:
#   строгий COCO Instances
#   пригоден для:
#
#   CVAT -> Upload annotations -> COCO 1.0
#
# ======================================================================


from google.colab import drive
drive.mount("/content/drive")

import gc
import json
import shutil
from pathlib import Path

import cv2
import numpy as np
import torch

from tqdm.auto import tqdm

from mmengine.config import Config
from mmdet.apis import (
    init_detector,
    inference_detector
)


# ======================================================================
# 1. ТРИ ПУТИ — МЕНЯЕШЬ ТОЛЬКО ИХ
# ======================================================================

# Папка с:
# best_dino_swin_l_map50_95.pth
# dino_swin_l_arm_config.py
# best_metrics.json

MODEL_DIR = Path(
    "/content/drive/MyDrive/Да_да_да/Detection/Weights"
)


# Папка с изображениями для инференса

INPUT_IMAGES_DIR = Path(
    "/content/drive/MyDrive/Да_да_да/Detection/Inference/images"
)


# Папка, куда будет сохранён готовый CVAT JSON

OUTPUT_DIR = Path(
    "/content/drive/MyDrive/Да_да_да/Detection/Inference/Output"
)


# ======================================================================
# 2. НАСТРОЙКИ INFERENCE
# ======================================================================

DEVICE = (
    "cuda:0"
    if torch.cuda.is_available()
    else "cpu"
)


# ------------------------------------------------------------
# CONFIDENCE THRESHOLD
#
# Все предсказания ниже этого confidence удаляются.
#
# При обучении для дополнительных метрик мы использовали 0.25,
# поэтому оставляем то же значение.
# ------------------------------------------------------------

SCORE_THRESHOLD = 0.25


# ------------------------------------------------------------
# ОСТАВЛЯТЬ ТОЛЬКО 2 СПОРТСМЕНОВ?
#
# False:
# сохраняются ВСЕ детекции >= threshold.
#
# True:
# сохраняются только 2 наиболее уверенные детекции.
#
# Я рекомендую сначала False, чтобы вручную проверить
# ложные срабатывания в CVAT.
# ------------------------------------------------------------

KEEP_ONLY_TOP_2 = False

TOP_K = 2


# ======================================================================
# 3. КЛАССЫ
#
# ДОЛЖНЫ БЫТЬ В ТОМ ЖЕ ПОРЯДКЕ, ЧТО И ПРИ ОБУЧЕНИИ
# ======================================================================

CLASSES = (
    "Toproll",
    "Hook",
    "Press",
    "Kingsmove",
)


# MMDetection labels:
#
# 0 -> Toproll
# 1 -> Hook
# 2 -> Press
# 3 -> Kingsmove
#
# COCO category_id:
#
# 1 -> Toproll
# 2 -> Hook
# 3 -> Press
# 4 -> Kingsmove

LABEL_TO_CATEGORY_ID = {
    0: 1,
    1: 2,
    2: 3,
    3: 4,
}


# ======================================================================
# 4. CVAT FILE NAME MODE
#
# Обычно при загрузке обычных изображений в CVAT имя изображения:
#
# hook_001.jpg
#
# Поэтому True — самый безопасный вариант.
#
# Если ты создавал CVAT task из ZIP с сохранением вложенных папок:
#
# folder/hook_001.jpg
#
# тогда поставь False.
# ======================================================================

USE_ONLY_FILENAME_FOR_CVAT = True


# ======================================================================
# 5. ПРОВЕРКА ПУТЕЙ
# ======================================================================

if not MODEL_DIR.is_dir():

    raise FileNotFoundError(
        f"Не найдена папка модели:\n"
        f"{MODEL_DIR}"
    )


if not INPUT_IMAGES_DIR.is_dir():

    raise FileNotFoundError(
        f"Не найдена папка изображений:\n"
        f"{INPUT_IMAGES_DIR}"
    )


OUTPUT_DIR.mkdir(
    parents=True,
    exist_ok=True
)


FINAL_JSON = (
    OUTPUT_DIR
    /
    "instances_cvat.json"
)


# ======================================================================
# 6. ЛОКАЛЬНЫЕ ПАПКИ
#
# Копируем всё с Google Drive один раз.
# Во время inference модель читает изображения из /content.
# ======================================================================

LOCAL_ROOT = Path(
    "/content/dino_inference"
)

LOCAL_MODEL_DIR = (
    LOCAL_ROOT
    /
    "model"
)

LOCAL_IMAGES_DIR = (
    LOCAL_ROOT
    /
    "images"
)


if LOCAL_ROOT.exists():

    shutil.rmtree(
        LOCAL_ROOT,
        ignore_errors=True
    )


LOCAL_ROOT.mkdir(
    parents=True,
    exist_ok=True
)


# ======================================================================
# 7. COPY MODEL -> /content
# ======================================================================

print("=" * 76)

print(
    "COPY MODEL TO /content"
)

print("=" * 76)


shutil.copytree(
    MODEL_DIR,
    LOCAL_MODEL_DIR
)


print(
    "✓ Model copied"
)


# ======================================================================
# 8. COPY IMAGES -> /content
# ======================================================================

print("\n" + "=" * 76)

print(
    "COPY IMAGES TO /content"
)

print("=" * 76)


shutil.copytree(
    INPUT_IMAGES_DIR,
    LOCAL_IMAGES_DIR
)


print(
    "✓ Images copied"
)


# ======================================================================
# 9. НАХОДИМ CONFIG
# ======================================================================

config_candidates = list(
    LOCAL_MODEL_DIR.glob(
        "*.py"
    )
)


if len(config_candidates) == 0:

    raise FileNotFoundError(
        "В MODEL_DIR не найден .py config."
    )


preferred_configs = [

    p

    for p in config_candidates

    if (
        "dino_swin_l_arm_config"
        in
        p.name.lower()
    )
]


if len(preferred_configs) >= 1:

    CONFIG_PATH = (
        preferred_configs[0]
    )


elif len(config_candidates) == 1:

    CONFIG_PATH = (
        config_candidates[0]
    )


else:

    print(
        "\nНайдено несколько .py:"
    )

    for p in config_candidates:
        print(" ", p.name)

    raise RuntimeError(
        "Не удалось автоматически выбрать config."
    )


# ======================================================================
# 10. НАХОДИМ ВЕСА
# ======================================================================

weight_candidates = list(
    LOCAL_MODEL_DIR.glob(
        "*.pth"
    )
)


if len(weight_candidates) == 0:

    raise FileNotFoundError(
        "В MODEL_DIR не найден .pth checkpoint."
    )


# Сначала ищем точное стандартное имя.

preferred_weights = [

    p

    for p in weight_candidates

    if (
        p.name.lower()
        ==
        "best_dino_swin_l_map50_95.pth"
    )
]


if len(preferred_weights) >= 1:

    CHECKPOINT_PATH = (
        preferred_weights[0]
    )


else:

    # Если стандартного имени нет —
    # пробуем найти единственный файл со словом best.

    best_weights = [

        p

        for p in weight_candidates

        if "best" in p.name.lower()
    ]


    if len(best_weights) == 1:

        CHECKPOINT_PATH = (
            best_weights[0]
        )


    elif len(weight_candidates) == 1:

        CHECKPOINT_PATH = (
            weight_candidates[0]
        )


    else:

        print(
            "\nНайдено несколько .pth:"
        )

        for p in weight_candidates:
            print(" ", p.name)

        raise RuntimeError(
            "Не удалось автоматически определить "
            "лучшие веса."
        )


# ======================================================================
# 11. ИЩЕМ ВСЕ ИЗОБРАЖЕНИЯ
# ======================================================================

IMAGE_EXTENSIONS = {
    ".jpg",
    ".jpeg",
    ".png",
    ".bmp",
    ".webp",
    ".tif",
    ".tiff",
}


image_paths = sorted(

    p

    for p in LOCAL_IMAGES_DIR.rglob("*")

    if (
        p.is_file()
        and
        p.suffix.lower()
        in IMAGE_EXTENSIONS
    )
)


if len(image_paths) == 0:

    raise FileNotFoundError(
        "Во входной папке нет изображений."
    )


# ======================================================================
# 12. ПРОВЕРЯЕМ ИМЕНА
#
# Если USE_ONLY_FILENAME_FOR_CVAT=True,
# одинаковых basename быть не должно.
# ======================================================================

if USE_ONLY_FILENAME_FOR_CVAT:

    names = [
        p.name
        for p in image_paths
    ]

    if (
        len(names)
        !=
        len(set(names))
    ):

        raise RuntimeError(
            "\nОбнаружены одинаковые имена файлов "
            "в разных подпапках.\n"
            "Нельзя безопасно использовать "
            "USE_ONLY_FILENAME_FOR_CVAT=True.\n"
            "Поставь False."
        )


# ======================================================================
# 13. INFO
# ======================================================================

print("\n" + "=" * 76)

print(
    "INFERENCE SETTINGS"
)

print("=" * 76)


print(
    "Config:"
)

print(
    CONFIG_PATH
)


print(
    "\nCheckpoint:"
)

print(
    CHECKPOINT_PATH
)


print(
    "\nImages:",
    len(image_paths)
)


print(
    "Device:",
    DEVICE
)


print(
    "Threshold:",
    SCORE_THRESHOLD
)


print(
    "Keep top 2:",
    KEEP_ONLY_TOP_2
)


print(
    "CVAT basename mode:",
    USE_ONLY_FILENAME_FOR_CVAT
)


print(
    "\nOutput:"
)

print(
    FINAL_JSON
)

print("=" * 76)


# ======================================================================
# 14. LOAD CONFIG
# ======================================================================

cfg = Config.fromfile(
    str(
        CONFIG_PATH
    )
