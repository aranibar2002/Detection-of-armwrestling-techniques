print("=" * 75)

print("Python:", sys.version)

assert sys.version_info[:2] == (3, 11), (
    "\nНУЖЕН PYTHON 3.11.\n"
    "Выбери в Colab Runtime Version 2025.07."
)

# Проверяем, что GPU вообще выдан
result = subprocess.run(
    ["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"],
    capture_output=True,
    text=True
)

if result.returncode != 0:
    raise RuntimeError(
        "GPU не обнаружена. "
        "Выбери T4 GPU в настройках среды выполнения."
    )

print("GPU:", result.stdout.strip())


# ======================================================================
# ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ
# ======================================================================

def run(cmd):
    """Выполняет команду и сразу останавливается при ошибке."""

    print("\n" + "=" * 75)
    print(">", " ".join(cmd))
    print("=" * 75)

    subprocess.check_call(cmd)


PYTHON = sys.executable


