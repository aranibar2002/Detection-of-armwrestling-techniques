def prepare_coco_json(
    root,
    source_json,
    output_json
):

    images_dir = (
        root / "images"
    )

    with open(
        source_json,
        "r",
        encoding="utf-8"
    ) as f:

        data = json.load(f)


    # ----------------------------------------------------------
    # CLASSES
    # ----------------------------------------------------------

    canonical = {

        cls.lower(): cls

        for cls in CLASSES
    }

    categories = {}


    for cat in data[
        "categories"
    ]:

        name = (
            str(
                cat["name"]
            )
            .strip()
            .lower()
        )

        if name not in canonical:

            raise ValueError(
                f"Неизвестный класс: {cat['name']}"
            )

        cat["name"] = (
            canonical[name]
        )

        categories[
            name
        ] = cat


    missing_classes = [

        cls

        for cls in CLASSES

        if cls.lower()
        not in categories
    ]


    if missing_classes:

        raise ValueError(
            f"Нет классов: {missing_classes}"
        )


    # Фиксируем порядок label:
    #
    # 0 Toproll
    # 1 Hook
    # 2 Press
    # 3 Kingsmove

    data["categories"] = [

        categories[
            cls.lower()
        ]

        for cls in CLASSES
    ]


    # ----------------------------------------------------------
    # FILE_NAME
    # ----------------------------------------------------------

    fixed = 0

    missing = []


    for image in data[
        "images"
    ]:

        old = str(
            image["file_name"]
        ).replace(
            "\\",
            "/"
        )

        parts = (
            PurePosixPath(
                old
            ).parts
        )

        found = None


        for start in range(
            len(parts)
        ):

            relative = Path(
                *parts[start:]
            )

            candidate = (
                images_dir
                / relative
            )

            if candidate.is_file():

                found = (
                    relative
                    .as_posix()
                )

                break


        if found is None:

            missing.append(
                old
            )

            continue


        if found != old:

            fixed += 1


        image[
            "file_name"
        ] = found


    if missing:

        print(
            "\nMissing:",
            len(missing)
        )

        for x in missing[:20]:
            print(x)

        raise FileNotFoundError(
            "Некоторые изображения из JSON не найдены."
        )


    # ----------------------------------------------------------
    # 2 BBOX CHECK
    # ----------------------------------------------------------

    counts = Counter()


    for ann in data[
        "annotations"
    ]:

        if not ann.get(
            "iscrowd",
            0
        ):

            counts[
                ann["image_id"]
            ] += 1


    wrong = []


    for image in data[
        "images"
    ]:

        n = counts[
            image["id"]
        ]

        if n != 2:

            wrong.append(
                (
                    image["id"],
                    n
                )
            )


    print("\nDataset:", root)

    print(
        "Images      :",
        len(
            data["images"]
        )
    )

    print(
        "Annotations :",
        len(
            data["annotations"]
        )
    )

    print(
        "Fixed paths :",
        fixed
    )


    if wrong:

        print(
            "WARNING: не 2 bbox:",
            len(wrong)
        )

        print(
            wrong[:10]
        )

    else:

        print(
            "✓ у каждого изображения ровно 2 bbox"
        )


    with open(
        output_json,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            data,
            f,
            ensure_ascii=False
        )


    return data


