def find_latest_resume_checkpoint(
    folder
):

    folder = Path(
        folder
    )

    candidates = []


    for path in folder.glob(
        "resume_epoch_*.pth"
    ):

        match = re.search(
            r"resume_epoch_(\d+)\.pth$",
            path.name
        )

        if match:

            candidates.append(
                (
                    int(
                        match.group(1)
                    ),
                    path
                )
            )


    if not candidates:

        return None


    candidates.sort(
        key=lambda x:
            x[0]
    )


    return candidates[
        -1
    ][1]


