def find_coco_json(root):

    ann_dir = (
        root / "annotations"
    )

    candidates = []

    for p in ann_dir.rglob(
        "*.json"
    ):

        stem = (
            p.stem.lower()
        )

        # backup/fixed не считаем рабочим JSON
        if "backup" in stem:
            continue

        if "fixed" in stem:
            continue

        try:

            with open(
                p,
                "r",
                encoding="utf-8"
            ) as f:

                data = json.load(f)

            if (
                isinstance(data, dict)
                and
                "images" in data
                and
                "annotations" in data
                and
                "categories" in data
            ):

                candidates.append(
                    p
                )

        except Exception:

            pass


    if len(candidates) == 0:

        raise FileNotFoundError(
            f"COCO JSON не найден:\n{ann_dir}"
        )


    if len(candidates) > 1:

        print(
            "\nНайдено несколько рабочих JSON:"
        )

        for p in candidates:
            print(" ", p)

        raise RuntimeError(
            "В annotations должен быть один рабочий COCO JSON."
        )


    return candidates[0]


