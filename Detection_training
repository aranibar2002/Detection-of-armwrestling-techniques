def to_numpy(x):

    if hasattr(
        x,
        "tensor"
    ):
        x = x.tensor

    if hasattr(
        x,
        "detach"
    ):
        x = x.detach()

    if hasattr(
        x,
        "cpu"
    ):
        x = x.cpu()

    if hasattr(
        x,
        "numpy"
    ):
        x = x.numpy()

    return np.asarray(
        x
    )


def iou_matrix(
    boxes1,
    boxes2
):

    boxes1 = np.asarray(
        boxes1,
        dtype=np.float32
    ).reshape(
        -1,
        4
    )

    boxes2 = np.asarray(
        boxes2,
        dtype=np.float32
    ).reshape(
        -1,
        4
    )


    if (
        len(boxes1) == 0
        or
        len(boxes2) == 0
    ):

        return np.zeros(
            (
                len(boxes1),
                len(boxes2)
            ),
            dtype=np.float32
        )


    lt = np.maximum(
        boxes1[
            :,
            None,
            :2
        ],
        boxes2[
            None,
            :,
            :2
        ]
    )


    rb = np.minimum(
        boxes1[
            :,
            None,
            2:
        ],
        boxes2[
            None,
            :,
            2:
        ]
    )


    wh = np.clip(
        rb - lt,
        0,
        None
    )


    intersection = (
        wh[..., 0]
        *
        wh[..., 1]
    )


    area1 = (
        np.clip(
            boxes1[:, 2]
            -
            boxes1[:, 0],
            0,
            None
        )
        *
        np.clip(
            boxes1[:, 3]
            -
            boxes1[:, 1],
            0,
            None
        )
    )


    area2 = (
        np.clip(
            boxes2[:, 2]
            -
            boxes2[:, 0],
            0,
            None
        )
        *
        np.clip(
            boxes2[:, 3]
            -
            boxes2[:, 1],
            0,
            None
        )
    )


    union = (
        area1[:, None]
        +
        area2[None, :]
        -
        intersection
    )


    return (
        intersection
        /
        np.maximum(
            union,
            1e-9
        )
    )


@METRICS.register_module(
    force=True
)
class TwoAthleteMetric(
    BaseMetric
):

    default_prefix = "arm"


    def __init__(
        self,
        ann_file,
        classes,
        score_thr=0.25,
        iou_thr=0.50,
        collect_device="cpu",
        prefix=None
    ):

        super().__init__(
            collect_device=collect_device,
            prefix=prefix
        )


        self.score_thr = float(
            score_thr
        )

        self.iou_thr = float(
            iou_thr
        )

        self.classes = tuple(
            classes
        )


        with open(
            ann_file,
            "r",
            encoding="utf-8"
        ) as f:

            coco = json.load(
                f
            )


        name_to_label = {

            name.lower(): index

            for index, name
            in enumerate(
                self.classes
            )
        }


        category_to_label = {}


        for category in coco[
            "categories"
        ]:

            category_to_label[
                int(
                    category[
                        "id"
                    ]
                )
            ] = (
                name_to_label[
                    category[
                        "name"
                    ].lower()
                ]
            )


        self.gt = defaultdict(
            lambda: {
                "boxes": [],
                "labels": []
            }
        )


        for ann in coco[
            "annotations"
        ]:

            if ann.get(
                "iscrowd",
                0
            ):
                continue

            if ann.get(
                "ignore",
                False
            ):
                continue


            x, y, w, h = (
                ann[
                    "bbox"
                ]
            )

            image_id = int(
                ann[
                    "image_id"
                ]
            )


            self.gt[
                image_id
            ][
                "boxes"
            ].append(
                [
                    x,
                    y,
                    x + w,
                    y + h
                ]
            )


            self.gt[
                image_id
            ][
                "labels"
            ].append(
                category_to_label[
                    int(
                        ann[
                            "category_id"
                        ]
                    )
                ]
            )


    def process(
        self,
        data_batch,
        data_samples
    ):

        for sample in data_samples:

            pred = sample[
                "pred_instances"
            ]

            image_id = int(
                sample[
                    "img_id"
                ]
            )


            pred_boxes = to_numpy(
                pred[
                    "bboxes"
                ]
            )

            pred_scores = to_numpy(
                pred[
                    "scores"
                ]
            )

            pred_labels = to_numpy(
                pred[
                    "labels"
                ]
            ).astype(
                np.int64
            )


            gt_info = self.gt[
                image_id
            ]


            gt_boxes = np.asarray(
                gt_info[
                    "boxes"
                ],
                dtype=np.float32
            ).reshape(
                -1,
                4
            )

            gt_labels = np.asarray(
                gt_info[
                    "labels"
                ],
                dtype=np.int64
            )


            self.results.append(
                dict(
                    pred_boxes=pred_boxes,
                    pred_scores=pred_scores,
                    pred_labels=pred_labels,

                    gt_boxes=gt_boxes,
                    gt_labels=gt_labels
                )
            )


    def compute_metrics(
        self,
        results
    ):

        TP = 0
        FP = 0
        FN = 0

        localized_total = 0

        technique_correct = 0

        both_correct_images = 0

        total_images = len(
            results
        )


        for result in results:

            pb = result[
                "pred_boxes"
            ]

            ps = result[
                "pred_scores"
            ]

            pl = result[
                "pred_labels"
            ]

            gb = result[
                "gt_boxes"
            ]

            gl = result[
                "gt_labels"
            ]


            keep = (
                ps
                >=
                self.score_thr
            )


            pb = pb[
                keep
            ]

            ps = ps[
                keep
            ]

            pl = pl[
                keep
            ]


            if len(
                ps
            ):

                order = (
                    np.argsort(
                        -ps
                    )
                )

                pb = pb[
                    order
                ]

                ps = ps[
                    order
                ]

                pl = pl[
                    order
                ]


            ious = (
                iou_matrix(
                    pb,
                    gb
                )
            )


            # --------------------------------------------------
            # Precision / Recall
            # --------------------------------------------------

            matched_gt = set()


            for pi in range(
                len(pb)
            ):

                candidates = [

                    gi

                    for gi in range(
                        len(gb)
                    )

                    if (
                        gi not in matched_gt
                        and
                        pl[pi]
                        ==
                        gl[gi]
                    )
                ]


                if not candidates:

                    FP += 1

                    continue


                candidate_ious = (
                    ious[
                        pi,
                        candidates
                    ]
                )


                best_pos = int(
                    np.argmax(
                        candidate_ious
                    )
                )

                best_gt = (
                    candidates[
                        best_pos
                    ]
                )

                best_iou = (
                    candidate_ious[
                        best_pos
                    ]
                )


                if (
                    best_iou
                    >=
                    self.iou_thr
                ):

                    TP += 1

                    matched_gt.add(
                        best_gt
                    )

                else:

                    FP += 1


            FN += (
                len(gb)
                -
                len(
                    matched_gt
                )
            )


            # --------------------------------------------------
            # Technique Accuracy
            # --------------------------------------------------

            pairs = []


            for pi in range(
                len(pb)
            ):

                for gi in range(
                    len(gb)
                ):

                    current_iou = (
                        ious[
                            pi,
                            gi
                        ]
                    )


                    if (
                        current_iou
                        >=
                        self.iou_thr
                    ):

                        pairs.append(
                            (
                                float(
                                    current_iou
                                ),
                                pi,
                                gi
                            )
                        )


            pairs.sort(
                key=lambda x:
                    x[0],
                reverse=True
            )


            used_pred = set()

            used_gt = set()

            selected = []


            for _, pi, gi in pairs:

                if pi in used_pred:
                    continue

                if gi in used_gt:
                    continue


                used_pred.add(
                    pi
                )

                used_gt.add(
                    gi
                )


                selected.append(
                    (
                        pi,
                        gi
                    )
                )


            localized_total += len(
                selected
            )


            correct_this_image = 0


            for pi, gi in selected:

                if (
                    pl[pi]
                    ==
                    gl[gi]
                ):

                    technique_correct += 1

                    correct_this_image += 1


            if (
                len(gb) == 2
                and
                len(selected) == 2
                and
                correct_this_image == 2
            ):

                both_correct_images += 1


        precision = (
            TP / (TP + FP)

            if TP + FP > 0

            else 0.0
        )


        recall = (
            TP / (TP + FN)

            if TP + FN > 0

            else 0.0
        )


        technique_accuracy = (
            technique_correct
            /
            localized_total

            if localized_total > 0

            else 0.0
        )


        both_correct_pct = (
            100.0
            *
            both_correct_images
            /
            total_images

            if total_images > 0

            else 0.0
        )


        return {
            "precision":
                float(
                    precision
                ),

            "recall":
                float(
                    recall
                ),

            "technique_accuracy":
                float(
                    technique_accuracy
                ),

            "both_correct_pct":
                float(
                    both_correct_pct
                ),
        }


# ======================================================================
# 17. RESUME CHECKPOINT HOOK
#
# Работает ПОСЛЕ validation.
#
# Каждые N эпох:
#
# 1. full state -> resume_epoch_XXX.pth
# 2. best weights -> best_so_far.pth
# 3. metadata -> resume_info.json
# 4. старые full checkpoints удаляются
#
# priority LOWEST:
# сначала стандартный CheckpointHook успевает обновить BEST mAP.
# ======================================================================

@HOOKS.register_module(
    force=True
)
class PeriodicDriveResumeHook(
    Hook
):

    priority = "LOWEST"


    def __init__(
        self,
        out_dir,
        interval=5,
        keep_last=2,
        metric_key="coco/bbox_mAP"
    ):

        self.out_dir = Path(
            out_dir
        )

        self.interval = int(
            interval
        )

        self.keep_last = int(
            keep_last
        )

        self.metric_key = (
            metric_key
        )

        self.out_dir.mkdir(
            parents=True,
            exist_ok=True
        )


    def _checkpoint_epoch(
        self,
        path
    ):

        match = re.search(
            r"resume_epoch_(\d+)\.pth$",
            path.name
        )

        if match:

            return int(
                match.group(1)
            )

        return -1


    def _cleanup_old(
        self
    ):

        if self.keep_last <= 0:
            return


        checkpoints = sorted(
            self.out_dir.glob(
                "resume_epoch_*.pth"
            ),
            key=self._checkpoint_epoch
        )


        while (
            len(checkpoints)
            >
            self.keep_last
        ):

            old = checkpoints.pop(
                0
            )

            try:

                old.unlink()

                print(
                    f"Removed old resume checkpoint: {old}"
                )

            except Exception as e:

                print(
                    "WARNING: cannot remove",
                    old,
                    e
                )


    def after_val_epoch(
        self,
        runner,
        metrics=None
    ):

        # После run_epoch MMEngine уже увеличил epoch.
        completed_epoch = int(
            runner.epoch
        )


        if completed_epoch <= 0:
            return


        if (
            completed_epoch
            %
            self.interval
            != 0
        ):

            return


        self.out_dir.mkdir(
            parents=True,
            exist_ok=True
        )


        # ------------------------------------------------------
        # METRICS
        # ------------------------------------------------------

        metrics = (
            metrics
            if metrics is not None
            else {}
        )


        current_map = metrics.get(
            self.metric_key,
            None
        )


        best_score = None


        if (
            "best_score"
            in
            runner.message_hub.runtime_info
        ):

            try:

                best_score = float(
                    runner.message_hub.get_info(
                        "best_score"
                    )
                )

            except Exception:

                best_score = None


        # ------------------------------------------------------
        # FULL TRAINING STATE
        # ------------------------------------------------------

        filename = (
            f"resume_epoch_"
            f"{completed_epoch:03d}.pth"
        )


        print("\n" + "=" * 78)

        print(
            f"SAVING FULL RESUME CHECKPOINT: "
            f"EPOCH {completed_epoch}"
        )

        print("=" * 78)


        meta = dict(

            epoch=completed_epoch,

            iter=int(
                runner.iter
            ),

            resume_epoch=completed_epoch,

            current_map50_95=(
                float(current_map)
                if current_map is not None
                else None
            ),

            best_map50_95=(
                best_score
            ),

            saved_at=(
                datetime.now()
                .isoformat()
            )
        )


        # ВАЖНО:
        #
        # save_optimizer=True
        # save_param_scheduler=True
        #
        # Поэтому resume продолжает реальное обучение,
        # а не просто загружает веса.

        runner.save_checkpoint(

            out_dir=str(
                self.out_dir
            ),

            filename=filename,

            save_optimizer=True,

            save_param_scheduler=True,

            meta=meta,

            by_epoch=True
        )


        full_path = (
            self.out_dir
            /
            filename
        )


        print(
            "\n✓ Full training state saved:"
        )

        print(
            full_path
        )


        # ------------------------------------------------------
        # BEST WEIGHTS SO FAR
        #
        # Стандартный CheckpointHook к этому моменту уже определил
        # лучший mAP и сохранил local best.
        # ------------------------------------------------------

        best_ckpt_path = None


        if (
            "best_ckpt"
            in
            runner.message_hub.runtime_info
        ):

            try:

                best_ckpt_path = Path(
                    runner.message_hub.get_info(
                        "best_ckpt"
                    )
                )

            except Exception:

                best_ckpt_path = None


        BEST_SO_FAR = (
            self.out_dir
            /
            "best_so_far.pth"
        )


        if (
            best_ckpt_path is not None
            and
            best_ckpt_path.is_file()
        ):

            shutil.copy2(
                best_ckpt_path,
                BEST_SO_FAR
            )

            print(
                "\n✓ Current BEST weights copied:"
            )

            print(
                BEST_SO_FAR
            )

        elif BEST_SO_FAR.exists():

            # На resume-run предыдущий best может находиться
            # уже только на Drive.
            #
            # Его не удаляем/не заменяем.
            print(
                "\n✓ Existing best_so_far preserved:"
            )

            print(
                BEST_SO_FAR
            )


        # ------------------------------------------------------
        # JSON INFO
        # ------------------------------------------------------

        info = dict(

            latest_resume_checkpoint=str(
                full_path
            ),

            completed_epoch=completed_epoch,

            iteration=int(
                runner.iter
            ),

            current_map50_95=(
                float(current_map)
                if current_map is not None
                else None
            ),

            best_map50_95=(
                best_score
            ),

            best_weights=str(
                BEST_SO_FAR
            )
            if BEST_SO_FAR.exists()
            else None,

            max_epochs=int(
                runner.max_epochs
            ),

            saved_at=(
                datetime.now()
                .isoformat()
            )
        )


        INFO_PATH = (
            self.out_dir
            /
            "resume_info.json"
        )


        with open(
            INFO_PATH,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                info,
                f,
                ensure_ascii=False,
                indent=2
            )


        # ------------------------------------------------------
        # KEEP ONLY LAST N
        # ------------------------------------------------------

        self._cleanup_old()


